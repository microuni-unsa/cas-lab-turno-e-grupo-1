@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #2C3E50
  FontColor #2C3E50
  FontSize 10
}
skinparam package {
  BackgroundColor #F1F4F8
  BorderColor #4A6572
  FontColor #1A252C
  FontStyle bold
  FontSize 11
}

title Organigrama de Roles del Proyecto SIGAE

rectangle "<font color=white><b>Jefe de Proyecto</b>\n<i>Coordinación General y Gestión de Riesgos</i></font>" as JP #C8310E

package "Área de Análisis y Diseño" {
  rectangle "<b>Analista de Requisitos</b>\nModelado ERS y trazabilidad" as AR
  rectangle "<b>Diseñador UI/UX</b>\nPrototipado e interfaces" as UX
}

package "Área de Arquitectura y Desarrollo" {
  rectangle "<b>Arquitecto de Software</b>\nArquitectura web, RBAC y auditoría" as AQ
  rectangle "<b>Equipo de Desarrollo</b>\nImplementación Backend y Frontend" as DEV
}

package "Área de Calidad y Operaciones" {
  rectangle "<b>Especialista de Calidad (QA)</b>\nPruebas funcionales, carga y seguridad" as QA
  rectangle "<b>Administrador de BD y DevOps</b>\nBase de datos, respaldos y HTTPS" as DBA
}

JP --> AR
JP --> AQ
JP --> QA

AR -[hidden]down-> UX
AQ -[hidden]down-> DEV
QA -[hidden]down-> DBA

@enduml
