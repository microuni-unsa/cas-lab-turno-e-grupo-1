@startuml
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Liberation Sans", "DejaVu Sans", sans-serif
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1A5276
  ArrowColor #1A5276
  HeaderBackgroundColor #EAECEE
}

class CajeroAutomatico {
  - idCajero: String
  + validarTarjetaYClave(tarjeta: Tarjeta, clave: String): Boolean
  + solicitarOperacion(op: Operacion): Boolean
}

class Consorcio {
  - nombreRed: String
  + enrutarOperacion(op: Operacion, banco: Banco): Boolean
}

class Banco {
  - codigoBanco: String
  - nombre: String
  + verificarClave(tarjeta: Tarjeta, clave: String): Boolean
  + procesarRetiro(cuenta: Cuenta, monto: Decimal): Boolean
  + procesarDeposito(cuenta: Cuenta, monto: Decimal): Boolean
  + procesarTransferencia(origen: Cuenta, destino: Cuenta, monto: Decimal): Boolean
  + obtenerMovimientos(cuenta: Cuenta): List<Movimiento>
  + obtenerSaldo(cuenta: Cuenta): Decimal
}

class Tarjeta {
  - numeroTarjeta: String
  - clavePIN: String
}

class Cuenta {
  - numeroCuenta: String
  - saldo: Decimal
}

abstract class Operacion {
  # fechaHora: DateTime
  + {abstract} ejecutar(): Boolean
}

class Retiro {
  - monto: Decimal
  + ejecutar(): Boolean
}

class Deposito {
  - monto: Decimal
  + ejecutar(): Boolean
}

class Transferencia {
  - cuentaDestino: String
  - monto: Decimal
  + ejecutar(): Boolean
}

class Consulta {
  - tipoInfo: String
  + ejecutar(): Boolean
}

CajeroAutomatico --> Consorcio : se conecta a
Consorcio --> Banco : enruta transacciones

Banco "1" *-- "1..*" Cuenta : gestiona
Banco "1" *-- "1..*" Tarjeta : emite
Cuenta "1" -- "1..*" Tarjeta : asociada

Operacion <|-- Retiro
Operacion <|-- Deposito
Operacion <|-- Transferencia
Operacion <|-- Consulta

CajeroAutomatico --> Operacion : ejecuta
Operacion --> Cuenta : aplica sobre
@enduml
